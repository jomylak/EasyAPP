# User data (NEVER commit)
profile.json
resume.txt
resume.pdf
# Any resume/CV variant, wherever it lands. The bare resume.pdf rule above
# missed real files like JakubOmylak_2026_Resume.pdf sitting in the repo root.
*[Rr]esume*.pdf
*[Rr]esume*.docx
*[Cc]over[_ ][Ll]etter*.pdf
*.cv.pdf
*.env
.env.*
!.env.example

# Runtime artifacts
*.db
tailored_resumes/
cover_letters/
chrome-workers/
apply-workers/
scripts/fingerprint_reports/
apply_logs/
logs/

# MCP configs (per-machine)
.mcp*.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Claude Code
.claude/

# Agent / browser scratch. Playwright MCP drops a page snapshot and a console
# log per step into here -- 400+ files and 7 MB after a few apply runs.
.playwright-mcp/
uploads/

# Test + lint caches
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtualenvs
.venv/
venv/
env/

# SQLite sidecars (the -wal can outlive a crashed run)
*.db-journal
*.db-wal
*.db-shm

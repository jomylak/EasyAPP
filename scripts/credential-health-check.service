[Unit]
Description=Daily check that Gmail OAuth and site logins are still alive

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/ApplyPilot
Environment=PATH=/home/ubuntu/ApplyPilot/.venv/bin:/usr/bin:/bin
ExecStart=/home/ubuntu/ApplyPilot/.venv/bin/python scripts/credential_health_check.py
